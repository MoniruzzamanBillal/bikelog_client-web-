# Docker does NOT consult .gitignore — everything excluded from the build context has to
# be listed here explicitly.

# Host-built dependencies (host-arch sharp and SWC binaries live in here)
node_modules
.pnp
.pnp.*
.yarn/install-state.gz

# Stale local build output — the builder stage must produce this fresh, never inherit it
.next
out
build

# ! SECURITY: .env.local on disk contains a live VERCEL_OIDC_TOKEN. Anything left in the
# ! build context can be baked into an image layer, so every .env* file stays out.
# ! This also has a deliberate side effect: Next reads .env/.env.production from the build
# ! context via @next/env, so excluding them makes the Dockerfile ARG the SOLE source of
# ! NEXT_PUBLIC_API_BASE_URL. The build can never silently pick up the on-disk value and
# ! pass it off as intentional — builds are reproducible from the compose args alone.
.env
.env.*

.vercel
.git
.github
.vscode
.claude

# docs and specs — nothing at build or run time reads these
*.md
context

# regenerated by `next build`; tsconfig.json lists it in `include`, but Next recreates it
# at build start, so excluding it is safe
next-env.d.ts
*.tsbuildinfo

Dockerfile
.dockerignore
docker-compose.yml

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage
*.pem
*.zip

# Deliberately NOT excluded, all needed by `next build`:
#   app/ components/ hooks/ lib/ utils/   the source
#   public/                               copied verbatim into the runner stage
#   next.config.ts                        output: "standalone" + images.remotePatterns
#   tsconfig.json                         the "@/*" path alias
#   postcss.config.mjs                    the Tailwind 4 pipeline
#   components.json                       shadcn config
